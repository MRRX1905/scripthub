# Publishable Supabase values. Nilai ini aman digunakan di aplikasi browser;
# jangan pernah memakai service_role atau secret key di Vite.
VITE_SUPABASE_URL=https://project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxx

# Username hanya untuk label/form login. Autentikasi sebenarnya tetap
# menggunakan akun Supabase Auth dengan app_metadata.role = "admin".
VITE_ADMIN_USERNAME=admin
VITE_ADMIN_EMAIL=ztropixsantuy@gmail.com

# Untuk custom domain atau deployment non-standar. Biarkan kosong untuk
# auto-detect GitHub Pages.
# VITE_BASE_PATH=/nama-repository/
