# Opsional untuk mengisi otomatis formulir koneksi admin.
# Jangan pernah menyimpan token GitHub di file .env atau repository.
VITE_GITHUB_OWNER=nama-akun-github
VITE_GITHUB_REPO=nama-repository
VITE_GITHUB_BRANCH=main
VITE_GITHUB_ADMIN_LOGIN=nama-akun-github
VITE_GITHUB_CONTENT_PATH=public/data/content.json

# Untuk custom domain atau deployment non-standar. Biarkan kosong untuk auto-detect GitHub Pages.
# VITE_BASE_PATH=/nama-repository/
